msgid "Test SMS Delivery"
msgstr "تست ارسال پیامک"

msgid "Send a sample OTP pattern (12345) to verify your settings or Sandbox log."
msgstr "یک پیامک آزمایشی با کد 12345 ارسال کنید تا تنظیمات درگاه یا لاگ آزمایشی بررسی شود."

msgid "Test Mobile Number"
msgstr "شماره موبایل آزمایشی"

msgid "Send Test SMS"
msgstr "ارسال پیامک آزمایشی"

msgid "Please enter a valid mobile number first."
msgstr "لطفاً ابتدا یک شماره موبایل معتبر وارد کنید."

msgid "Sending..."
msgstr "در حال ارسال..."

msgid "An unexpected error occurred while sending the test SMS."
msgstr "خطای غیرمنتظره‌ای هنگام ارسال پیامک آزمایشی رخ داد."

msgid "Sandbox test logged to wp-content/debug.log successfully."
msgstr "پیامک آزمایشی با موفقیت در wp-content/debug.log ثبت شد."

msgid "Test SMS dispatched via Melipayamak gateway successfully."
msgstr "پیامک آزمایشی با موفقیت از طریق ملی‌پیامک ارسال شد."

msgid "Melipayamak requires an API Key instead of your panel password."
msgstr "ملی‌پیامک استفاده از API Key را به جای رمز عبور پنل الزامی کرده است."

msgid "Server IP address is not allowlisted in Melipayamak panel settings."
msgstr "آی‌پی سرور در لیست آی‌پی‌های مجاز پنل ملی‌پیامک ثبت نشده است."

msgid "Server IP temporarily blocked by Melipayamak due to failed attempts."
msgstr "آی‌پی سرور به دلیل تلاش‌های ناموفق موقتاً توسط ملی‌پیامک مسدود شده است."

msgid "Pattern variables do not match the approved Melipayamak pattern."
msgstr "متغیرهای ارسالی با الگوی تاییدشده در ملی‌پیامک مطابقت ندارند."

msgid "Pattern code (BodyId) is invalid or not yet approved in Melipayamak."
msgstr "کد الگوی پیامک (BodyId) نامعتبر است یا هنوز در ملی‌پیامک تایید نشده است."

msgid "Melipayamak web service pattern access is disabled for this account."
msgstr "دسترسی وب‌سرویس پیامک الگودار (پترن) برای این حساب غیرفعال است."

msgid "Invalid Melipayamak username, password, or API key."
msgstr "نام کاربری، رمز عبور یا API Key ملی‌پیامک اشتباه است."

msgid "Insufficient SMS credit in your Melipayamak account."
msgstr "اعتبار حساب ملی‌پیامک کافی نیست."

msgid "Melipayamak user account verification documents are incomplete."
msgstr "مدارک احراز هویت پنل ملی‌پیامک تکمیل نشده است."

msgid "Hourly SMS sending limit reached in Melipayamak."
msgstr "محدودیت ارسال ساعتی در پنل ملی‌پیامک تکمیل شده است."

msgid "The recipient mobile number is in the telecom blacklist (Code 35)."
msgstr "شماره گیرنده در لیست سیاه مخابرات قرار دارد (کد ۳۵)."

msgid "Unable to send verification code at the moment. Please try again later."
msgstr "امکان ارسال کد تایید در حال حاضر وجود ندارد. لطفاً دقایقی دیگر تلاش کنید."

msgid "WooCommerce Bridge"
msgstr "پل ووکامرس"

msgid "Connects OTP mobile identity, checkout phone validation, and transactional order SMS with WooCommerce."
msgstr "اتصال احراز هویت پیامکی، اعتبارسنجی شماره تسویه‌حساب و پیامک وضعیت سفارش به ووکامرس."

msgid "Requires the WooCommerce plugin to be installed and active."
msgstr "نیازمند نصب و فعال بودن افزونه ووکامرس است."

msgid "Please enter a valid Iranian mobile number (e.g. 09123456789)."
msgstr "لطفاً یک شماره موبایل معتبر ایرانی وارد کنید (مثلاً 09123456789)."

msgid "WooCommerce"
msgstr "ووکامرس"

msgid "WooCommerce Integration & Order SMS"
msgstr "یکپارچه‌سازی ووکامرس و پیامک سفارش"

msgid "Mobile & Checkout Sync"
msgstr "همگام‌سازی موبایل و تسویه‌حساب"

msgid "Sync verified OTP mobile with WooCommerce billing phone and prefill checkout"
msgstr "همگام‌سازی موبایل تاییدشده با تلفن صورتحساب و پر کردن خودکار تسویه‌حساب"

msgid "Iranian Mobile Validation"
msgstr "اعتبارسنجی موبایل ایرانی"

msgid "Require a valid Iranian mobile number (09xxxxxxxxx) on checkout"
msgstr "الزام وارد کردن شماره موبایل معتبر ایران (09xxxxxxxxx) در صفحه تسویه‌حساب"

msgid "New Order Pattern Code (BodyId)"
msgstr "کد الگوی ثبت سفارش جدید (BodyId)"

msgid "Optional Melipayamak BodyId sent to customer on new order (passes order number as parameter). Leave blank to disable."
msgstr "کد الگوی اختیاری ملی‌پیامک هنگام ثبت سفارش جدید (شماره سفارش ارسال می‌شود). برای غیرفعال‌سازی خالی بگذارید."

msgid "Completed Order Pattern Code (BodyId)"
msgstr "کد الگوی تکمیل سفارش (BodyId)"

msgid "Optional Melipayamak BodyId sent to customer when order status becomes Completed. Leave blank to disable."
msgstr "کد الگوی اختیاری ملی‌پیامک هنگام تکمیل سفارش. برای غیرفعال‌سازی خالی بگذارید."

msgid "Configure WooCommerce customer mobile synchronization and optional Melipayamak order notifications."
msgstr "تنظیم همگام‌سازی شماره موبایل مشتریان ووکامرس و اعلان پیامکی اختیاری سفارش‌ها."

msgid "tomans"
msgstr "تومان"

msgid "Passwordless OTP login is not permitted for this account role."
msgstr "ورود بدون رمز عبور با پیامک برای این نقش کاربری مجاز نیست."

msgid "Could not encrypt the SMS password because OpenSSL encryption is unavailable. Please define NEORA_SMS_PASSWORD in wp-config.php."
msgstr "رمز درگاه پیامک به‌دلیل در دسترس نبودن OpenSSL رمزنگاری نشد. لطفاً ثابت NEORA_SMS_PASSWORD را در wp-config.php تعریف کنید."

msgid "The stored SMS gateway password could not be decrypted (for example, OpenSSL is unavailable or site salts changed). Please re-enter the password or define NEORA_SMS_PASSWORD in wp-config.php."
msgstr "رمز ذخیره‌شده درگاه پیامک قابل رمزگشایی نیست (ممکن است OpenSSL فعال نباشد یا کلیدهای امنیتی سایت تغییر کرده باشند). لطفاً رمز را دوباره وارد کنید یا NEORA_SMS_PASSWORD را در wp-config.php قرار دهید."

msgid "Legacy Billing Phone Login"
