{
    "name": "neora/neora-core",
    "description": "Neora Core WordPress Plugin",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "brain/monkey": "^2.7",
        "mockery/mockery": "^1.6"
    },
    "autoload": {
        "psr-4": {
            "NeoraStudio\\NeoraCore\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "NeoraStudio\\NeoraCore\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --do-not-cache-result",
        "phpcs": "phpcs --standard=phpcs.xml.dist",
        "phpcbf": "phpcbf --standard=phpcs.xml.dist"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}