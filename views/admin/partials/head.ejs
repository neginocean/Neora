<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= docTitle || 'Neora Core' %></title>
  <meta name="description" content="The modular foundation platform powering Neora Studio websites." />
  <meta property="og:title" content="<%= docTitle || 'Neora Core' %>" />
  <meta property="og:description" content="The modular foundation platform powering Neora Studio websites." />
  <link rel="stylesheet" href="/assets/admin/neora-admin.css" />
  <style>
    body {
      margin: 0;
      padding: 0;
      background: #f0f0f1;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Oxygen-Sans, Ubuntu, Cantarell, "Helvetica Neue", sans-serif;
      font-size: 13px;
      line-height: 1.4;
      color: #1d2327;
    }
    .neora-shell {
      max-width: 1160px;
      margin: 0 auto;
      padding: 12px 20px 32px;
    }
    .neora-admin-wrap {
      margin: 12px auto 32px !important;
    }
    .notice {
      background: #fff;
      border: 1px solid #c3c4c7;
      border-left-width: 4px;
      box-shadow: 0 1px 1px rgba(0, 0, 0, 0.04);
      margin: 5px 0 18px;
      padding: 10px 14px;
      border-radius: 6px;
    }
    .notice p { margin: 0; }
    .notice-success { border-left-color: #00a32a; }
    .notice-warning { border-left-color: #dba617; }
    .notice-error { border-left-color: #d63638; }
    .form-table {
      border-collapse: collapse;
      margin-top: 0.5em;
      width: 100%;
    }
    .form-table th {
      vertical-align: top;
      text-align: left;
      padding: 16px 12px 16px 0;
      width: 220px;
      font-weight: 600;
    }
    .form-table td {
      padding: 14px 10px;
      vertical-align: middle;
    }
    .form-table input[type="text"],
    .form-table input[type="password"],
    .form-table input[type="url"],
    .form-table select {
      font-size: 14px;
      line-height: 1.5;
      min-height: 34px;
      background: #fff;
      border: 1px solid #cbd5e1;
      border-radius: 6px;
      padding: 4px 10px;
    }
    .form-table input.regular-text {
      width: 25em;
      max-width: 100%;
    }
    .form-table .description {
      margin: 6px 0 0;
      color: #64748b;
      font-size: 12.5px;
    }
    .neora-admin-footer {
      max-width: 1120px;
      margin: 16px auto 0;
      font-size: 12px;
      color: #64748b;
    }
    @media (max-width: 782px) {
      .form-table th, .form-table td {
        display: block;
        width: 100%;
        padding: 8px 0;
      }
    }
  </style>
  <style><%- inlineCss %></style>
</head>
<body>
  <div class="neora-shell">
