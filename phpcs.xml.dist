<?xml version="1.0"?>
<ruleset name="Neora Core">
	<description>WordPress Coding Standards for Neora Core (PSR-4 &amp; PHP 8.1+).</description>

	<file>./neora-core.php</file>
	<file>./uninstall.php</file>
	<file>./src</file>
	<file>./views</file>

	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/tests/*</exclude-pattern>

	<arg value="ps"/>
	<arg name="colors"/>
	<arg name="extensions" value="php"/>

	<config name="minimum_wp_version" value="6.3"/>
	<config name="testVersion" value="8.1-"/>

	<rule ref="WordPress-Extra">
		<!-- PSR-4 class filenames are required by the autoloader -->
		<exclude name="WordPress.Files.FileName"/>
		<!-- Project requires PHP 8.1+ and uses short array syntax consistently -->
		<exclude name="Universal.Arrays.DisallowShortArraySyntax"/>
		<!-- Allow existing 4-space files alongside tab-indented files -->
		<exclude name="Generic.WhiteSpace.DisallowSpaceIndent"/>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="neora"/>
				<element value="NeoraStudio"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="neora-core"/>
			</property>
		</properties>
	</rule>
</ruleset>